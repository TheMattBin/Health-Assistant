# AI model provider: openrouter (default, hosted, no GPU) or local (MedGemma)
LLM_PROVIDER=openrouter
# Get a key at https://openrouter.ai/keys (free models work)
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Must accept images for PDF/image questions. Fallbacks are comma-separated,
# tried in order when a model is rate-limited or down.
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free
OPENROUTER_FALLBACK_MODELS=google/gemma-4-31b-it:free
# Per-model timeout in seconds, and the reply length cap
LLM_TIMEOUT_S=25
LLM_MAX_TOKENS=1000

# Hugging Face token, only for LLM_PROVIDER=local (MedGemma is a gated model)
# Get your token from: https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_token_here

# Backend Configuration
BACKEND_URL=http://localhost:8000
API_SECRET_KEY=your_secret_key_here

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
NODE_ENV=development

# Database (if you migrate from file-based storage)
# DATABASE_URL=postgresql://user:password@localhost:5432/health_assistant

# OAuth Configuration (if needed)
# OAUTH_CLIENT_ID=your_oauth_client_id
# OAUTH_CLIENT_SECRET=your_oauth_client_secret
# OAUTH_REDIRECT_URI=http://localhost:3000/auth/callback

# Redis Configuration (if needed for session management)
# REDIS_URL=redis://localhost:6379

# File Upload Configuration
MAX_FILE_SIZE=10485760  # 10MB in bytes
ALLOWED_FILE_TYPES=pdf,png,jpg,jpeg