# Hugging Face Token - Required for MedGemma AI model
# Get your token from: https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_token_here

# Backend Configuration
BACKEND_URL=http://localhost:8000
API_SECRET_KEY=your_secret_key_here

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
NODE_ENV=development

# Database (if you migrate from file-based storage)
# DATABASE_URL=postgresql://user:password@localhost:5432/health_assistant

# OAuth Configuration (if needed)
# OAUTH_CLIENT_ID=your_oauth_client_id
# OAUTH_CLIENT_SECRET=your_oauth_client_secret
# OAUTH_REDIRECT_URI=http://localhost:3000/auth/callback

# Redis Configuration (if needed for session management)
# REDIS_URL=redis://localhost:6379

# File Upload Configuration
MAX_FILE_SIZE=10485760  # 10MB in bytes
ALLOWED_FILE_TYPES=pdf,png,jpg,jpeg