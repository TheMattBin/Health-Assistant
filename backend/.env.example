# AI model provider: openrouter (default, hosted, no GPU) or local (MedGemma)
LLM_PROVIDER=openrouter
# Get a key at https://openrouter.ai/keys (free models work)
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Must accept images for PDF/image questions. Fallbacks are comma-separated,
# tried in order when a model is rate-limited or down.
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free
OPENROUTER_FALLBACK_MODELS=google/gemma-4-31b-it:free
# Per-model timeout in seconds, and the reply length cap
LLM_TIMEOUT_S=25
LLM_MAX_TOKENS=1000

# Hugging Face token, only for LLM_PROVIDER=local (MedGemma is a gated model)
HF_TOKEN=your_hf_token_here

# OAuth2 Configuration - Google
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# OAuth2 Configuration - Facebook
FACEBOOK_CLIENT_ID=your_facebook_client_id_here
FACEBOOK_CLIENT_SECRET=your_facebook_client_secret_here

# JWT Configuration
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Application URLs (for OAuth2 redirect)
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000